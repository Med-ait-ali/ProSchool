rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Homework attachments — teachers upload, authenticated users read
    match /homework/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024  // max 10MB
                   && request.resource.contentType.matches('application/pdf|application/msword|application/vnd.*');
    }

    // School logos — admin only
    match /logos/{fileName} {
      allow read:  if true;
      allow write: if request.auth != null;
    }
  }
}
